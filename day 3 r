            if (a % b == 0) {
                System.out.println(
                    "Greater Number is a Multiple of Smaller Number"
                );
            } else {
                System.out.println(
                    "Greater Number is Not a Multiple"
                );
            }
        } else {
            if (b % a == 0) {
                System.out.println(
                    "Greater Number is a Multiple of Smaller Number"
                );
            } else {
                System.out.println(
                    "Greater Number is Not a Multiple"
                );
            }
        }

        sc.close();
    }
}
