import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        double amount = sc.nextDouble();

        double finalAmount = amount >= 2000
                ? amount * 0.90
                : amount;

        System.out.printf("%.2f%n", finalAmount);
    }
